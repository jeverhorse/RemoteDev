{
  "sync-settle": {
    "enabled": true,
    "PostToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "python -c \"import time; time.sleep(0.1)\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
